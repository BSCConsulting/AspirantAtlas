# ==============================================================
# AspirantAtlas - Cloudflare R2 Configuration Example
# ==============================================================

# Public URL for downloads (Can be your custom domain or pub-*.r2.dev URL)
VITE_R2_PUBLIC_URL=https://cdn.aspirantatlas.org

# Bucket Name
VITE_R2_BUCKET_NAME=aspirant-atlas-vault

# S3-Compatible Credentials for administrative upload script (Keep Private)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
